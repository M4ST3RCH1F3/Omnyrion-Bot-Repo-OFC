
# Auto-ativação do bot (já incluso no start.sh, mas mantido por segurança)
clear && bash "/sdcard/Omnyrion Bot/start.sh"

# Ligar o Bot
alias botlive='clear && bash "/sdcard/Omnyrion Bot/start.sh"7'

# Restartar o Bot
alias botrelive='tmux kill-session -t omnyrion && clear && bash "/sdcard/Omnyrion Bot/start.sh"'

# Ver os logs do bot (entrar no tmux)
alias botlog='tmux attach -t omnyrion'

# Matar o bot (se precisar reiniciar)
alias botkill='tmux kill-session -t omnyrion'

# Navegar direto para a pasta do bot
alias botdir='cd "/sdcard/Omnyrion Bot"'

# Sincronização do BASHRC (copia o .bashrc atual para o modelo)
alias syncbash='cp "/sdcard/Omnyrion Bot/bashrc_model" ~/.bashrc && echo "✅ bashrc_model atualizado, Reiniciando..." && exit'
